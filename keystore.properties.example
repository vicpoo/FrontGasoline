# Copia este archivo como keystore.properties (en la raíz del proyecto, junto a settings.gradle.kts).
# keystore.properties está en .gitignore: NUNCA lo subas, ni el .jks.
#
# storeFile: ruta ABSOLUTA al keystore, fuera del repositorio. En Windows usa / o \\ (ej. C:/llaves/gasoline-release.jks).
# Si se pierde el keystore no se pueden publicar actualizaciones de la app con el mismo nombre de paquete:
# guárdalo (y estas contraseñas) en un gestor de contraseñas o un lugar seguro con respaldo.
storeFile=C:/llaves/gasoline-release.jks
storePassword=CAMBIAR
keyAlias=gasoline
keyPassword=CAMBIAR
