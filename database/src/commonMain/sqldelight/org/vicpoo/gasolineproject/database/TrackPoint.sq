-- Puntos GPS de los viajes (antes: trip_recording/points/<viaje>.jsonl).
-- seq empieza en 0 y crece de uno en uno por viaje: "los puntos desde el N" es una consulta por
-- llave (seq >= N), sin OFFSET, aunque el viaje tenga miles de puntos.
CREATE TABLE track_point (
    trip_local_id TEXT NOT NULL,
    seq INTEGER NOT NULL,
    lat REAL NOT NULL,
    lng REAL NOT NULL,
    t TEXT NOT NULL,
    acc REAL,
    alt REAL,
    spd REAL,
    PRIMARY KEY (trip_local_id, seq)
);

insert:
INSERT INTO track_point(trip_local_id, seq, lat, lng, t, acc, alt, spd)
VALUES ?;

nextSeq:
SELECT coalesce(max(seq) + 1, 0) FROM track_point WHERE trip_local_id = ?;

countForTrip:
SELECT count(*) FROM track_point WHERE trip_local_id = ?;

pageForTrip:
SELECT * FROM track_point
WHERE trip_local_id = ? AND seq >= ?
ORDER BY seq
LIMIT ?;

deleteForTrip:
DELETE FROM track_point WHERE trip_local_id = ?;

deleteAll:
DELETE FROM track_point;
