-- Listas largas que llegan por páginas de la API: historial de viajes ("trips"), mis solicitudes
-- ("my_reservations") y las de la empresa ("company_reservations"). Más recientes primero:
-- ORDER BY sort_key DESC, item_id DESC. La app las recorre por llave (KeySetPaginationManager),
-- nunca con OFFSET: "la página siguiente" son las filas con llave menor que la última que se ve.
CREATE TABLE ListItemEntity (
    list_name TEXT NOT NULL,
    item_id TEXT NOT NULL,
    sort_key TEXT NOT NULL,
    json TEXT NOT NULL,
    PRIMARY KEY (list_name, item_id)
);

CREATE INDEX list_item_order ON ListItemEntity(list_name, sort_key, item_id);
