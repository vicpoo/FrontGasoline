-- Vehículos de la empresa guardados en el teléfono (antes: vehicles/vehicles.json).
-- El vehículo completo va en json (VehicleEntity); las columnas sueltas son las que se usan para
-- filtrar y contar en SQL.
CREATE TABLE vehicle (
    local_id TEXT NOT NULL PRIMARY KEY,
    server_id TEXT,
    sync_state TEXT NOT NULL,
    json TEXT NOT NULL
);

CREATE INDEX vehicle_server_id ON vehicle(server_id);

selectAll:
SELECT json FROM vehicle;

selectById:
SELECT json FROM vehicle WHERE local_id = ?;

-- Lo que ve la UI: todo menos lo que se borró sin conexión y espera mandarse a la API
selectVisible:
SELECT json FROM vehicle WHERE sync_state <> 'PENDING_DELETE';

selectVisibleById:
SELECT json FROM vehicle WHERE local_id = ? AND sync_state <> 'PENDING_DELETE';

countPending:
SELECT count(*) FROM vehicle WHERE sync_state <> 'SYNCED';

countAll:
SELECT count(*) FROM vehicle;

upsert:
INSERT OR REPLACE INTO vehicle(local_id, server_id, sync_state, json) VALUES (?, ?, ?, ?);

remove:
DELETE FROM vehicle WHERE local_id = ?;

removeAll:
DELETE FROM vehicle;
