<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Splash de Octrak en Android 12+ (claro/oscuro según el teléfono): igual que values/themes.xml
        y además el nombre "Octrak" en la parte de abajo (branding).
    -->
    <style name="Theme.Gasoline.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/window_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/octrak_splash</item>
        <item name="android:windowSplashScreenBrandingImage">@drawable/octrak_splash_branding</item>
        <item name="postSplashScreenTheme">@style/Theme.Gasoline</item>
    </style>
</resources>
