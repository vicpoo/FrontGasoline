<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Tema de la ventana de Android (modo claro).
        Solo controla el fondo mientras arranca la app; los colores reales
        de la UI están en shared/.../core/ui/theme/AppColors.kt.
    -->
    <style name="Theme.Gasoline" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
    </style>

    <!--
        Pantalla de inicio (splash) con el logo, como Airbnb.
        El fondo usa @color/window_background: blanco en modo claro y negro en modo oscuro
        (values-night/colors.xml). El logo es el mismo en ambos modos.
        Al terminar de arrancar cambia a Theme.Gasoline.
    -->
    <style name="Theme.Gasoline.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/window_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_logo</item>
        <item name="postSplashScreenTheme">@style/Theme.Gasoline</item>
    </style>
</resources>
