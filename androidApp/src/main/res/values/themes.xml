<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Tema de la ventana de Android (modo claro).
        Solo controla el fondo mientras arranca la app; los colores reales
        de la UI están en shared/.../core/ui/theme/AppColors.kt.
    -->
    <style name="Theme.Gasoline" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
    </style>

    <!--
        Pantalla de inicio (splash) de Gaspot. Usa el modo de la app: el del teléfono, o el que el
        usuario eligió en Perfil (Android 12+, ver MainActivity.applyThemeMode):
        - Claro: fondo blanco, pin azul (#476D9E) con nivel y bomba Navy, y nombre Navy (drawable/).
        - Oscuro: fondo negro, pin blanco con nivel azul, bomba blanca y nombre blanco (drawable-night/).
        El fondo usa @color/window_background (values-night/colors.xml para el oscuro).
        En Android 12+ además se muestra el nombre "Gaspot" abajo (values-v31/themes.xml).
        Al terminar de arrancar cambia a Theme.Gasoline.
    -->
    <style name="Theme.Gasoline.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/window_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/gaspot_splash</item>
        <item name="postSplashScreenTheme">@style/Theme.Gasoline</item>
    </style>
</resources>
