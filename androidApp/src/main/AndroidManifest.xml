<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Viajes: GPS mientras el viaje está en curso (también con la pantalla apagada) -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Viajes: pedir que el sistema no frene el GPS por "optimización de batería" (Xiaomi, Realme, Oppo...) -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <uses-feature android:name="android.hardware.location.gps" android:required="false" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <!--
        networkSecurityConfig: HTTP sin TLS solo hacia el servidor de APIGasoline; todo lo demás va por
        HTTPS (res/xml/network_security_config.xml).
        allowBackup="false" + dataExtractionRules: los datos de la app no entran al respaldo de Android
        ni a la transferencia entre teléfonos (placas, rutas GPS, fotos, cola sin enviar, sesión).
    -->
    <application
        android:name=".GasolineApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        tools:targetApi="31"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.Gasoline">
        <activity
            android:exported="true"
            android:theme="@style/Theme.Gasoline.Starting"
            android:windowSoftInputMode="adjustResize"
            android:launchMode="singleTop"
            android:configChanges="uiMode"
            android:name=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Mantiene vivo el registro GPS del viaje en segundo plano (muestra una notificación) -->
        <service
            android:name="org.vicpoo.gasolineproject.platform.location.TripTrackingService"
            android:exported="false"
            android:foregroundServiceType="location" />

        <!-- Notificaciones push (Firebase Cloud Messaging): solicitudes de vehículos -->
        <service
            android:name="org.vicpoo.gasolineproject.platform.push.GasolineMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
        <!-- Con la app cerrada Firebase muestra el push solo: con este ícono y en este canal -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_notification" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="solicitudes" />

        <!-- La cámara guarda la foto (recibos, perfil) en un archivo temporal de la app -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
